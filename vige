def vige(alp, mess, cle):
    cle.upper()
    mess.upper()
    message_decripte = ""
    i = 0
    for lettre in mess:
        indice = (alp.index(lettre) + alp.index(cle[i % len(cle)])) % len(alp)
        message_decripte += alp[indice]
        i += 1
    return message_decripte


